<?xml version="1.0" encoding="utf-8"?><!--
   Rules for Android 11 and below. See https://developer.android.com/guide/topics/data/autobackup

   The log directory is excluded: session files carry device details, absolute file paths,
   playback history and network connection details, none of which should leave the device
   through a cloud backup.
-->
<full-backup-content>
    <exclude
        domain="file"
        path="logs" />
</full-backup-content>
