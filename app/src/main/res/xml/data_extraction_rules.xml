<?xml version="1.0" encoding="utf-8"?><!--
   Rules for Android 12 and above. See
   https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The log directory is excluded from both cloud backup and device transfer: session files carry
   device details, absolute file paths, playback history and network connection details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="logs" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="logs" />
    </device-transfer>
</data-extraction-rules>
